rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Leaderboards (current + archived months): public read, server-only write.
    // A signed-in user may delete their OWN row (account deletion fallback).
    match /{board}/{uid} {
      allow read: if board.matches('players_.*');
      allow delete: if board.matches('players_.*')
                    && request.auth != null && request.auth.uid == uid;
      allow create, update: if false;
    }

    // Live price cache: public read
    match /market/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Your own portfolio state: read your own; delete your own on account removal
    match /states/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if false;
    }

    // Trade history: private to owner, until the month is released for everyone
    match /trades/{uid}/log/{id} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/releases/$(resource.data.month)).data.open == true
      );
      allow write: if false;
    }

    // Pending limit orders: owner can read and cancel (delete); server creates/fills
    match /orders/{id} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if false;
    }

    match /releases/{month} {
      allow read: if true;
      allow write: if false;
    }

    // Winners archive + Hall of Fame: public read
    match /winners/{month} {
      allow read: if true;
      allow write: if false;
    }
    match /halloffame/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Unique player names: claim your own
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.uid == request.auth.uid;
    }
  }
}
